{
  "name": "videojs-mobile-ui",
  "version": "1.2.9",
  "description": "Mobile tap controls and fullscreen on rotate for Video.js",
  "main": "dist/videojs-mobile-ui.cjs.js",
  "module": "dist/videojs-mobile-ui.es.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mister-ben/videojs-mobile-ui.git"
  },
  "browser": "dist/videojs-mobile-ui.js",
  "scripts": {
    "build": "node scripts/tasks.js build",
    "build-prod": "node scripts/tasks.js build-prod",
    "build-test": "node scripts/tasks.js build-test",
    "build:css": "node scripts/css.js",
    "build:js": "rollup -c scripts/rollup.config.js",
    "build:lang": "node ./scripts/lang.js",
    "clean": "node scripts/tasks.js clean",
    "docs:options": "node scripts/readme-options.js",
    "lint": "vjsstandard",
    "server": "karma start scripts/karma.conf.js --singleRun=false --auto-watch",
    "start": "node scripts/tasks.js start",
    "test": "node scripts/tasks.js test",
    "posttest": "node scripts/tasks.js posttest",
    "update-changelog": "conventional-changelog -n scripts/changelog.config.js -i CHANGELOG.md",
    "preversion": "npm test",
    "version": "is-prerelease || npm run update-changelog && git add CHANGELOG.md",
    "watch": "node scripts/tasks.js watch",
    "watch:css": "npm run build:css -- -w",
    "watch:js": "npm run build:js -- -w",
    "prepublishOnly": "node scripts/tasks.js publish",
    "netlify": "node ./scripts/netlify.js",
    "verify-package": "node scripts/verify-package.js",
    "test:package": "node test/package.js",
    "test:tasks": "node test/tasks.js",
    "test:changelog": "node test/changelog.js",
    "test:coverage": "node test/coverage.js"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=6"
  },
  "keywords": [
    "videojs",
    "videojs-plugin"
  ],
  "author": "mister-ben <git@misterben.me>",
  "license": "MIT",
  "vjsstandard": {
    "ignore": [
      "es",
      "cjs",
      "dist",
      "docs",
      "test/dist"
    ]
  },
  "files": [
    "CONTRIBUTING.md",
    "dist/",
    "index.html",
    "scripts/",
    "src/",
    "test/"
  ],
  "dependencies": {
    "global": "^4.4.0"
  },
  "peerDependencies": {
    "video.js": "^8"
  },
  "devDependencies": {
    "@babel/core": "^7.11.6",
    "@babel/preset-env": "^7.11.5",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "conventional-changelog": "^8.1.3",
    "is-ci": "^4.1.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "karma": "^6.3.2",
    "karma-browserstack-launcher": "~1.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-detect-browsers": "^2.3.3",
    "karma-firefox-launcher": "^2.1.3",
    "karma-ie-launcher": "^1.0.0",
    "karma-qunit": "^4.2.0",
    "karma-safari-applescript-launcher": "^0.1.1",
    "karma-static-server": "^2.0.0",
    "karma-teamcity-reporter": "^1.1.0",
    "not-prerelease": "^1.0.1",
    "qunit": "~2.16.0",
    "rollup": "^2.46.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "rollup-plugin-istanbul": "^5.0.0",
    "sinon": "^22.0.0",
    "video.js": "^8.0.0",
    "videojs-standard": "^9.0.1"
  },
  "overrides": {
    "nomnom": {
      "underscore": "^1.13.0"
    }
  }
}
